<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="620.0"
            styleClass="app-shell"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17.0.7"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="wwaffle.gui.MainWindow">
    <top>
        <VBox styleClass="app-header">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2.0">
                    <Label styleClass="wordmark" text="WWAFFLE" />
                    <Label styleClass="tagline" text="PERSONAL TASK MANAGER" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="taskStatus" styleClass="status-pill" text="0 TASKS READY" />
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="chat-scroll"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="4.0"
                      styleClass="dialog-list" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="9.0" styleClass="composer-panel">
            <Label styleClass="command-hint"
                   text="Try  list  ·  todo read a book  ·  find book  ·  bye" />
            <HBox alignment="CENTER" spacing="10.0" styleClass="composer-row">
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type a command…"
                           HBox.hgrow="ALWAYS" />
                <Button defaultButton="true"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send  ›" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
